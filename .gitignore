# ---- generated data (reproducible with: python -m generator.generate) ----
# anchored to the repo root: bi/src/data (the BI snapshot) and site/src/data must stay tracked
/data/
*.ndjson
*.ndjson.gz

# ---- secrets ----
.env
*.env
profiles.yml
# the CI profile holds only env_var() references, no secret: it is committed on purpose
!ci/profiles.yml

# ---- dbt artifacts ----
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/dbt_internal_packages/
dbt/.user.yml
ci/.user.yml

# ---- python ----
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# ---- delivery gate reports (written on demand with --report) ----
qa/reports/
gate_report*.md
triage_*.md

# ---- BI pages and portfolio site (Observable Framework): dependencies, build output, cache ----
bi/node_modules/
bi/dist/
bi/src/.observablehq/cache/
site/node_modules/
site/dist/
site/src/.observablehq/cache/

# ---- the assembled GitHub Pages folder (tools/site/assemble.py) ----
_site/

# ---- dbt logs when dbt is run from the repo root ----
logs/

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/
